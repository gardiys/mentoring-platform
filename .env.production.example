# Домен без https://. A/AAAA-запись должна указывать на production-сервер.
DOMAIN=platform.example.com
CADDY_EMAIL=admin@example.com

# Emergency kill switch for new repeat-Python applications and checkout.
# Existing applications, enrollments and installment payments stay readable/payable.
PYTHON_REPEAT_MENTORSHIP_ENABLED=true
OPPORTUNITIES_ENABLED=true
CONSULTATIONS_ENABLED=true
PYTHON_TO_GO_ENABLED=true

# Используйте URL-safe пароль, например результат: openssl rand -hex 32
POSTGRES_USER=mentoring
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
POSTGRES_DB=mentoring
DATABASE_URL=postgresql+asyncpg://mentoring:REPLACE_WITH_RANDOM_HEX@postgres:5432/mentoring
# Redis password is embedded into an internal URL; keep it URL-safe.
# Generate one with: openssl rand -hex 32
REDIS_PASSWORD=REPLACE_WITH_AT_LEAST_32_URL_SAFE_RANDOM_CHARACTERS

TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
TELEGRAM_BOT_URL=https://t.me/replace_with_your_bot
BOT_INTEGRATION_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Public API URL проекта codewaste-onboarding. Используйте тот же случайный
# секрет, что и MENTORING_PLATFORM_INTEGRATION_TOKEN в окружении бота.
ONBOARDING_BOT_API_BASE_URL=https://onboarding.example.com
ONBOARDING_BOT_INTEGRATION_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ONBOARDING_BOT_TIMEOUT_SECONDS=15
TELEGRAM_INIT_DATA_TTL_SECONDS=86400

# @BotFather → Bot Settings → Web Login. Добавьте origin и callback из README.
TELEGRAM_WEB_CLIENT_ID=REPLACE_WITH_WEB_LOGIN_CLIENT_ID
TELEGRAM_WEB_CLIENT_SECRET=REPLACE_WITH_WEB_LOGIN_CLIENT_SECRET
# Оставьте пустым; задайте HTTPS/HTTP proxy только если VPS блокирует oauth.telegram.org.
TELEGRAM_OIDC_PROXY_URL=
# ID чата/супергруппы «Паровоз собеседований», обычно отрицательное число.
TELEGRAM_INTERVIEW_CHAT_ID=
# ID топика forum-группы. Оставьте пустым для публикации в общий чат.
TELEGRAM_GROUP_TOPIC_ID=
# Отдельные чаты/топики направлений имеют приоритет над общими значениями выше.
TELEGRAM_INTERVIEW_PYTHON_CHAT_ID=
TELEGRAM_INTERVIEW_PYTHON_TOPIC_ID=
TELEGRAM_INTERVIEW_GO_CHAT_ID=
TELEGRAM_INTERVIEW_GO_TOPIC_ID=
# Можно указать тот же HTTP(S)-proxy, что и для Telegram OAuth.
TELEGRAM_BOT_PROXY_URL=
NOTIFICATION_REMINDER_TIMEZONE=Europe/Moscow
NOTIFICATION_REMINDER_HOUR=10
TELEGRAM_GROUP_CALL_REMINDERS_ENABLED=true
TELEGRAM_GROUP_CALL_REMINDER_MINUTES=30
TELEGRAM_DAILY_REMINDERS_ENABLED=true
TELEGRAM_DAILY_REMINDER_HOUR=20
WEB_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
WEB_SESSION_TTL_SECONDS=2592000

# Интернет-эквайринг Точка Банка. Проверьте параметры чека по своему договору.
TOCHKA_CLIENT_ID=REPLACE_WITH_TOCHKA_CLIENT_ID
TOCHKA_JWT_TOKEN=REPLACE_WITH_TOCHKA_JWT_TOKEN
TOCHKA_API_BASE_URL=https://enter.tochka.com/uapi
# Оставьте пустым, если enter.tochka.com доступен с production-сервера напрямую.
# Не копируйте сюда Telegram/OpenAI proxy: TLS-подмена сломает платежи.
TOCHKA_PROXY_URL=
# В Docker Compose задаётся автоматически после установки официальных CA Минцифры.
TOCHKA_CA_BUNDLE_PATH=
TOCHKA_PUBLIC_KEY=REPLACE_WITH_TOCHKA_WEBHOOK_PUBLIC_KEY
TOCHKA_CUSTOMER_CODE=REPLACE_WITH_TOCHKA_CUSTOMER_CODE
# TOCHKA_REDIRECT_URL and TOCHKA_FAIL_REDIRECT_URL are generated from DOMAIN
# by infra/docker-compose.prod.yml.
TOCHKA_PAYMENT_MODES=sbp,card
TOCHKA_PAYMENT_PURPOSE=Оплата услуг по программе менторства
TOCHKA_RECEIPT_TAX_SYSTEM_CODE=osn
TOCHKA_RECEIPT_VAT_TYPE=none
TOCHKA_RECEIPT_PAYMENT_METHOD=full_payment
TOCHKA_RECEIPT_PAYMENT_OBJECT=service
TOCHKA_RECEIPT_ITEM_NAME=Информационно-консультационные услуги
TOCHKA_RECEIPT_MEASURE=шт.
TOCHKA_SUPPLIER_NAME=
TOCHKA_SUPPLIER_PHONE=
TOCHKA_SUPPLIER_TAX_CODE=

BACKEND_WORKERS=2
LOG_LEVEL=INFO

# Внешний приватный S3 bucket. Endpoint оставьте пустым для AWS S3.
S3_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
S3_REGION=ru-central1
S3_ENDPOINT_URL=https://storage.example.com
S3_PUBLIC_ENDPOINT_URL=https://storage.example.com
S3_ACCESS_KEY_ID=REPLACE_WITH_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_S3_SECRET_KEY
S3_PRESIGN_TTL_SECONDS=900
# 64 MiB на часть; URL части живёт 6 часов; вся upload-сессия — сутки.
S3_MULTIPART_PART_SIZE_BYTES=67108864
S3_MULTIPART_PRESIGN_TTL_SECONDS=21600
S3_MULTIPART_SESSION_TTL_SECONDS=86400
INTERVIEW_STREAM_TICKET_TTL_SECONDS=600
# S3-ссылка выдаётся только после проверки HttpOnly playback-ticket.
MEDIA_STREAM_REDIRECT_TTL_SECONDS=900

# Видео в базе знаний и материалах роадмапов — до 5 GiB.
CONTENT_VIDEO_MAX_BYTES=5368709120
# A dedicated disk-backed volume is required. At the 5 GiB upload limit one
# normalization job needs about 10.5 GiB plus free-space headroom.
CONTENT_MEDIA_NORMALIZATION_DIRECTORY=/var/lib/mentoring/content-media-normalization
CONTENT_MEDIA_NORMALIZATION_MAX_CONCURRENCY=1
CONTENT_MEDIA_NORMALIZATION_MIN_FREE_BYTES=2147483648
CONTENT_MEDIA_NORMALIZATION_MAX_RESERVED_BYTES=12884901888
CONTENT_MEDIA_NORMALIZATION_OUTPUT_OVERHEAD_BYTES=536870912
CONTENT_MEDIA_NORMALIZATION_CLEANUP_AGE_SECONDS=86400
CONTENT_MEDIA_NORMALIZATION_TIMEOUT_SECONDS=14400
CONTENT_MEDIA_NORMALIZATION_STALE_SECONDS=18000
CONTENT_MEDIA_NORMALIZATION_JOB_EXPIRES_SECONDS=604800
CONTENT_MEDIA_NORMALIZATION_SOURCE_DELETE_GRACE_SECONDS=86400
CONTENT_MEDIA_NORMALIZATION_MAX_DURATION_SECONDS=43200
CONTENT_MEDIA_NORMALIZATION_PROBE_TIMEOUT_SECONDS=120
# Максимум: 2 GiB для видео, 500 MiB для аудио, 20 MiB для оффера.
INTERVIEW_VIDEO_MAX_BYTES=2147483648
INTERVIEW_AUDIO_MAX_BYTES=524288000
INTERVIEW_OFFER_MAX_BYTES=20971520
INTERVIEW_ATTACHMENT_MAX_BYTES=52428800
INTERVIEW_MEDIA_MAX_DURATION_SECONDS=14400
INTERVIEW_STAGING_DIRECTORY=/tmp/interview-staging
INTERVIEW_STAGING_MAX_CONCURRENCY=2
INTERVIEW_STAGING_MIN_FREE_BYTES=2147483648
INTERVIEW_STAGING_MAX_RESERVED_BYTES=4294967296
INTERVIEW_STAGING_CLEANUP_AGE_SECONDS=86400
INTERVIEW_MEDIA_PROBE_TIMEOUT_SECONDS=20
# Must be a regular disk-backed volume writable by uid/gid 10001, not container tmpfs.
INTERVIEW_LEGACY_TRANSCODE_DIRECTORY=/var/lib/mentoring/interview-legacy-transcode
INTERVIEW_LEGACY_TRANSCODE_MAX_CONCURRENCY=1
INTERVIEW_LEGACY_TRANSCODE_MIN_FREE_BYTES=2147483648
INTERVIEW_LEGACY_TRANSCODE_MAX_RESERVED_BYTES=1073741824
INTERVIEW_LEGACY_TRANSCODE_CLEANUP_AGE_SECONDS=86400
INTERVIEW_LEGACY_TRANSCODE_TIMEOUT_SECONDS=600

# Распознавание длинных записей через официальный Nexara Python SDK.
# REDIS_URL is assembled by production Compose from REDIS_PASSWORD.
INTELLIGENCE_JOB_EXPIRES_SECONDS=604800
TRANSCRIPTION_PROVIDER=nexara
TRANSCRIPTION_MAX_CONCURRENCY=4
TRANSCRIPTION_JOB_TIMEOUT_SECONDS=3600
TRANSCRIPTION_POLL_DEADLINE_SECONDS=21600
NEXARA_API_KEY=REPLACE_WITH_NEXARA_API_KEY
NEXARA_BASE_URL=https://api.nexara.ru/v1
NEXARA_MODEL=whisper-1
NEXARA_TIMEOUT_SECONDS=600
NEXARA_MAX_RETRIES=0

INTERVIEW_AI_PROVIDER=openai
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_ANALYSIS_MODEL=REPLACE_WITH_MODEL_ID
OPENAI_EXTRACTION_MODEL=REPLACE_WITH_MODEL_ID
OPENAI_LIGHT_REVIEW_MODEL=REPLACE_WITH_CHEAP_MODEL_ID
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=256
OPENAI_PROXY_URL=http://REPLACE_WITH_PRIVATE_AMSTERDAM_PROXY:3128
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=0
OPENAI_MAX_CONCURRENCY=4
OPENAI_JOB_TIMEOUT_SECONDS=3600
OPENAI_EXTRACTION_MAX_OUTPUT_TOKENS=8000
OPENAI_REVIEW_MAX_OUTPUT_TOKENS=4000
OPENAI_SUMMARY_MAX_OUTPUT_TOKENS=4000
# Set these from the current prices for the configured models. Zero means token-only accounting.
OPENAI_LIGHT_INPUT_PRICE_PER_MILLION_USD=0
OPENAI_LIGHT_OUTPUT_PRICE_PER_MILLION_USD=0
OPENAI_ANALYSIS_INPUT_PRICE_PER_MILLION_USD=0
OPENAI_ANALYSIS_OUTPUT_PRICE_PER_MILLION_USD=0
INTERVIEW_AI_EXTRACTION_CONFIDENCE_THRESHOLD=0.65
INTERVIEW_CARD_FREQUENT_MIN_OCCURRENCES=3
INTERVIEW_AI_ENABLED=true
INTERVIEW_AI_DAILY_LIMIT=1
INTERVIEW_AI_MAX_ACTIVE_PER_USER=1
INTERVIEW_AI_GLOBAL_ACTIVE_LIMIT=50
INTERVIEW_AI_QUOTA_TIMEZONE=Europe/Moscow
