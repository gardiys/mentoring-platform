APP_ENV=development
APP_DEBUG=true
DEV_AUTH_ENABLED=true
DATABASE_URL=postgresql+asyncpg://mentoring:mentoring@localhost:5432/mentoring
TEST_DATABASE_URL=postgresql+asyncpg://mentoring:mentoring@localhost:5432/mentoring_test
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
TELEGRAM_BOT_TOKEN=
TELEGRAM_INIT_DATA_TTL_SECONDS=86400
TELEGRAM_WEB_CLIENT_ID=
TELEGRAM_WEB_CLIENT_SECRET=
TELEGRAM_WEB_REDIRECT_URI=http://localhost:8000/api/v1/auth/web/telegram/callback
