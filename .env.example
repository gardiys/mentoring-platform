NEXARA_TIMEOUT_SECONDS=600
NEXARA_MAX_RETRIES=0
INTERVIEW_AI_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=
OPENAI_EXTRACTION_MODEL=
OPENAI_LIGHT_REVIEW_MODEL=
